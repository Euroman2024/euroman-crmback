generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       RolUsuario
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversaciones Conversacion[] @relation("UsuarioConversaciones")
}

model WhatsappAccount {
  id        String   @id @default(uuid())
  nombre    String
  numero    String?
  estado    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversaciones Conversacion[]
}

model Contacto {
  id            String   @id @default(uuid())
  nombre        String?
  telefono      String   @unique
  fotoPerfilUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversaciones Conversacion[]
}

model Conversacion {
  id                String @id @default(uuid())

  contactoId        String
  whatsappAccountId String
  asignadoA         String?
  notaAsignacion    String?

  estado EstadoConversacion @default(nuevo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacto Contacto @relation(fields: [contactoId], references: [id])

  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id])

  usuario Usuario? @relation("UsuarioConversaciones", fields: [asignadoA], references: [id])

  mensajes Mensaje[]
}

model Mensaje {
  id             String @id @default(uuid())
  whatsappMsgId  String @unique @default(uuid()) // ID original de WhatsApp para evitar duplicados
  conversacionId String

  contenido  String
  archivoUrl String?
  mimetype   String?
  tipo       TipoMensaje
  
  quotedMensajeId String?
  quotedContenido String?

  createdAt DateTime @default(now())

  conversacion Conversacion @relation(fields: [conversacionId], references: [id])
}

enum TipoMensaje {
  incoming
  outgoing
}

enum EstadoConversacion {
  nuevo
  leido
  respondido
  seguimiento
  cerrado
}

enum RolUsuario {
  admin
  vendedor
}